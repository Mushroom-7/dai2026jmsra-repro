    class broadcast,jmsra decision
    classDef compute fill:#E8F5E9,stroke:#347A46,color:#17202A,stroke-width:1.5px
    class aa_infer,ea_infer compute
    classDef evidence fill:#F1F3F5,stroke:#4D5964,color:#17202A,stroke-width:1.5px
